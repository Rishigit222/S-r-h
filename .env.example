# =====================================================================
# Self-Healing RAG Engine Configuration
# =====================================================================

# LLM Provider: "ollama" (local) | "groq" (fast cloud) | "google" (Gemini)
LLM_PROVIDER=ollama

# Ollama settings (default local runner, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi4-mini

# Groq settings (free key from https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google AI Studio (free key from https://aistudio.google.com)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Retrieval Hyperparameters
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5
VECTOR_WEIGHT=0.5
BM25_WEIGHT=0.5
RRF_K=60

# Guardrail Thresholds
RELEVANCE_THRESHOLD=0.3
FAITHFULNESS_THRESHOLD=0.5
MAX_HEAL_RETRIES=2

# Self-Healing Control Plane Settings
LATENCY_SLA_MS=10000.0
MAX_REPAIR_ATTEMPTS=3
IMPROVEMENT_THRESHOLD=0.02
REGRESSION_THRESHOLD=-0.01

# Storage Paths
CHROMA_PERSIST_DIR=./data/chroma_db
DOCUMENTS_DIR=./data/sample_docs
