# LLM Provider: "ollama" (default, free, local) | "groq" (free, fast) | "google" (free, big context)
LLM_PROVIDER=ollama

# Ollama settings (default, no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi4-mini

# Groq settings (free key from https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google AI Studio (free key from https://aistudio.google.com)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Retrieval settings
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5

# Guardrail thresholds
RELEVANCE_THRESHOLD=0.3
FAITHFULNESS_THRESHOLD=0.5
MAX_HEAL_RETRIES=2

# Paths
CHROMA_PERSIST_DIR=./data/chroma_db
DOCUMENTS_DIR=./data/sample_docs
